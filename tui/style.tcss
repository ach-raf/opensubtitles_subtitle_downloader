$canvas: #090d12;
$surface: #101720;
$surface-raised: #151f2b;
$line: #263446;
$ink: #e7edf5;
$muted: #8390a2;
$blue: #75a7ff;
$green: #68d5a4;
$amber: #e7b96a;
$red: #ef7777;

Screen {
    background: $canvas;
    color: $ink;
}

TopBar {
    height: 4;
    background: $surface;
    border-bottom: solid $line;
    padding: 0 1;
    align-vertical: middle;
}

#brand {
    width: 9;
    color: $green;
    text-style: bold;
    content-align: left middle;
}

.tab {
    min-width: 9;
    width: 9;
    height: 3;
    border: none;
    background: transparent;
    color: $muted;
}

.tab:hover,
.tab.active {
    color: $ink;
    background: $surface-raised;
}

.tab.active {
    border-bottom: heavy $green;
}

.tab.dirty {
    color: $amber;
}

.top-spacer {
    width: 1fr;
}

.chip {
    width: 18;
    height: 3;
    margin-left: 1;
    border: round $line;
    background: $surface-raised;
    color: $ink;
}

#chip-language {
    width: 9;
    min-width: 9;
}

.chip:hover {
    border: round $blue;
}

#workspace {
    height: 1fr;
}

#search-view,
#queue-view,
#history-view,
#config-view {
    height: 100%;
    padding: 1 2;
    background: $canvas;
}

QueryBar {
    height: 5;
    background: $surface;
    border: round $line;
    padding: 0 1;
    align-vertical: middle;
}

#query-label {
    width: 8;
    color: $muted;
    text-style: bold;
    content-align: left middle;
}

#query-input {
    width: 1fr;
    height: 3;
    border: none;
    background: $canvas;
}

#query-input:focus {
    border: tall $blue;
}

#query-submit {
    width: 12;
    height: 3;
    margin-left: 1;
}

#query-meta {
    width: 15;
    color: $muted;
    content-align: right middle;
}

#search-split {
    height: 1fr;
}

#search-state {
    height: 2;
    padding: 0 2;
    color: $muted;
    background: $surface;
    border-bottom: solid $line;
}

#results-panel {
    width: 1fr;
    height: 100%;
    background: $surface;
    border: round $line;
}

.panel-title,
.view-title {
    height: 3;
    padding: 1 1 0 1;
    color: $muted;
    text-style: bold;
}

.view-title {
    color: $ink;
}

.view-subtitle {
    height: 2;
    color: $muted;
    padding: 0 1;
}

ResultsTable,
#queue-table,
#history-table {
    height: 1fr;
    background: $surface;
    border: none;
}

.queue-actions {
    height: 4;
    dock: bottom;
    align-vertical: middle;
}

.queue-actions Button {
    width: 18;
    margin-right: 1;
}

DataTable > .datatable--header {
    background: $surface-raised;
    color: $muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #203146;
    color: $ink;
}

DetailPane {
    width: 38;
    min-width: 30;
    height: 100%;
    margin-left: 1;
    padding: 0 2 1 2;
    background: $surface;
    border: round $line;
}

#detail-title {
    height: auto;
    min-height: 3;
    margin-top: 1;
    color: $ink;
    text-style: bold;
}

#detail-provider {
    height: 2;
    color: $blue;
}

#detail-kv {
    height: auto;
    margin: 1 0;
    color: $muted;
}

#download-selected,
#copy-url {
    width: 100%;
    margin-top: 1;
}

#config-scroll {
    height: 1fr;
    scrollbar-color: $line;
}

#config-view {
    padding: 0 2;
}

#config-view > .view-title {
    height: 2;
    padding: 0 1;
    content-align: left middle;
}

#config-view > .view-subtitle {
    height: 1;
    padding: 0 1;
}

.config-heading {
    height: 2;
    margin-top: 0;
    padding: 0 1;
    content-align: left middle;
    color: $amber;
    text-style: bold;
    border-bottom: solid $line;
}

.config-row {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
}

.config-row Label {
    width: 32;
    color: $ink;
}

.config-row Button,
.config-row Select,
.config-row Input {
    width: 1fr;
}

.config-row Switch {
    width: auto;
}

#config-provider-languages {
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $line;
}

#config-actions {
    height: 3;
    dock: bottom;
    align-vertical: middle;
    background: $surface;
    border-top: solid $line;
    padding: 0 1;
}

#config-save {
    width: 18;
}

#config-discard {
    width: 20;
    margin-left: 1;
}

#config-save-status {
    width: 1fr;
    padding-left: 2;
    color: $muted;
}

StatusBar {
    height: 3;
    padding: 0 2;
    background: $surface;
    border-top: solid $line;
    align-vertical: middle;
}

#status-message {
    width: 1fr;
}

#status-progress {
    width: auto;
    min-width: 18;
    color: $muted;
    content-align: center middle;
}

#status-hints {
    width: auto;
    color: $muted;
    content-align: right middle;
}

Button.-primary {
    background: $green;
    color: #07110d;
    text-style: bold;
    border: none;
}

Button.-primary:hover {
    background: #83e9bb;
}

Notification {
    background: $surface-raised;
    border: round $blue;
    color: $ink;
}
